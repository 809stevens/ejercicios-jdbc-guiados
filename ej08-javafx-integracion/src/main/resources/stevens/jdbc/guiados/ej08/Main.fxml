<?xml version="1.0" encoding="UTF-8"?>

<!--
  =====================================================================
  Vista principal: formulario + tabla
  =====================================================================
  Este FXML es SOLO la interfaz. No contiene lógica ni SQL.
  Todos los fx:id deben coincidir con los @FXML del Controller.
  Todos los onAction="#..." deben coincidir con métodos del Controller.

  Layout:
    - Barra superior con título
    - Panel izquierdo (formulario): nombre, carrera, nota, correo
    - Panel derecho: buscador + TableView
    - Barra inferior: botones Guardar / Editar / Eliminar / Limpiar / Actualizar
    - Mensaje al pie
  =====================================================================
-->
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="520.0" prefWidth="980.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="stevens.jdbc.guiados.ej08.controllers.MainController">
   <children>
      <!-- Barra superior -->
      <AnchorPane prefHeight="64.0" prefWidth="980.0" style="-fx-background-color: #1c143b;">
         <children>
            <Label layoutX="20.0" layoutY="20.0" text="Agenda de Estudiantes" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Label>
            <Label layoutX="640.0" layoutY="24.0" text="JavaFX + MySQL (JDBC)" textFill="#a1bfba">
               <font>
                  <Font size="12.0" />
               </font>
            </Label>
         </children>
      </AnchorPane>

      <!-- Panel izquierdo: formulario -->
      <AnchorPane layoutY="64.0" prefHeight="390.0" prefWidth="380.0" style="-fx-background-color: #eceff1;">
         <children>
            <Label layoutX="16.0" layoutY="16.0" text="Datos del estudiante">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Label>

            <Label layoutX="16.0" layoutY="55.0" text="Nombre" />
            <TextField fx:id="txtNombre" layoutX="16.0" layoutY="78.0" prefHeight="28.0" prefWidth="348.0" promptText="Ej: Ana López" />

            <Label layoutX="16.0" layoutY="118.0" text="Carrera" />
            <TextField fx:id="txtCarrera" layoutX="16.0" layoutY="141.0" prefHeight="28.0" prefWidth="348.0" promptText="Ej: Ingeniería en Informática" />

            <Label layoutX="16.0" layoutY="181.0" text="Nota (1.0 - 7.0)" />
            <TextField fx:id="txtNota" layoutX="16.0" layoutY="204.0" prefHeight="28.0" prefWidth="348.0" promptText="Ej: 6.5" />

            <Label layoutX="16.0" layoutY="244.0" text="Correo" />
            <TextField fx:id="txtCorreo" layoutX="16.0" layoutY="267.0" prefHeight="28.0" prefWidth="348.0" promptText="Ej: ana.lopez@duocuc.cl" />

            <Label layoutX="16.0" layoutY="312.0" prefHeight="60.0" prefWidth="348.0" style="-fx-font-size: 11px;" text="Flujo: Formulario -> Controller -> Service -> DAO -> MySQL. El SQL nunca está en esta vista." wrapText="true" />
         </children>
      </AnchorPane>

      <!-- Panel derecho: buscador + tabla -->
      <VBox layoutX="380.0" layoutY="64.0" prefHeight="390.0" prefWidth="600.0" spacing="8.0">
         <padding>
            <Insets bottom="8.0" left="12.0" right="12.0" top="12.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT" spacing="8.0">
               <children>
                  <Label text="Buscar:" />
                  <TextField fx:id="txtBuscar" prefHeight="28.0" prefWidth="300.0" promptText="Filtra por nombre, carrera o correo..." />
                  <Button mnemonicParsing="false" onAction="#btnActualizar" text="Actualizar" />
               </children>
            </HBox>
            <TableView fx:id="tblEstudiante" VBox.vgrow="ALWAYS" onMouseClicked="#filaSeleccionada">
               <columns>
                  <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                  <TableColumn fx:id="colNombre" prefWidth="140.0" text="Nombre" />
                  <TableColumn fx:id="colCarrera" prefWidth="170.0" text="Carrera" />
                  <TableColumn fx:id="colNota" prefWidth="70.0" text="Nota" />
                  <TableColumn fx:id="colCorreo" prefWidth="170.0" text="Correo" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>

      <!-- Barra de botones -->
      <HBox layoutY="454.0" prefHeight="36.0" prefWidth="980.0" spacing="10.0" style="-fx-background-color: #eceff1;">
         <padding>
            <Insets bottom="4.0" left="16.0" right="16.0" top="4.0" />
         </padding>
         <children>
            <Button mnemonicParsing="false" onAction="#btnGuardar" style="-fx-background-color: #2e7d32;" text="Guardar" textFill="WHITE" />
            <Button mnemonicParsing="false" onAction="#btnEditar" style="-fx-background-color: #1565c0;" text="Editar" textFill="WHITE" />
            <Button mnemonicParsing="false" onAction="#btnEliminar" style="-fx-background-color: #c62828;" text="Eliminar" textFill="WHITE" />
            <Button mnemonicParsing="false" onAction="#btnLimpiar" text="Limpiar" />
         </children>
      </HBox>

      <!-- Mensaje -->
      <Label fx:id="lblMensaje" layoutX="16.0" layoutY="494.0" prefHeight="20.0" prefWidth="948.0" style="-fx-font-size: 12px; -fx-font-weight: bold;" text="Inicia la aplicación para cargar los datos desde MySQL" />
   </children>
</AnchorPane>
